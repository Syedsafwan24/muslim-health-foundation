DATABASE_URL="postgresql://mhf:mhf@localhost:5433/mhf"
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_TRUST_HOST=true
# Public origin, set in production so auth callbacks and redirects are absolute.
AUTH_URL="http://localhost:3100"
# 32 bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ID_ENCRYPTION_KEY="replace-me"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_BUCKET="mhf-private"
S3_ACCESS_KEY_ID="mhfminio"
S3_SECRET_ACCESS_KEY="mhfminio-secret"

# Production only, read by docker-compose.prod.yml. Locally the base
# docker-compose.yml supplies its own development defaults and these are unused.
MHF_PG_PASSWORD="replace-me"
MHF_S3_ACCESS_KEY="replace-me"
MHF_S3_SECRET_KEY="replace-me"
